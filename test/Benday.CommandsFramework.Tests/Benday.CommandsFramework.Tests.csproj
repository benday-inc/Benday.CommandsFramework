<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Benday.Common.Testing" Version="3.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
    
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    
    <PackageReference Include="xunit.v3" Version="3.2.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Benday.CommandsFramework\Benday.CommandsFramework.csproj" />
    <ProjectReference Include="..\Benday.CommandsFramework.Samples\Benday.CommandsFramework.Samples.csproj" />
    <!-- cmdui has to read both the 4.x and the 5.x schema on the same machine, since it is a
         global tool that probes whatever tools happen to be installed. Referencing it here is
         what lets that compatibility be tested rather than assumed. -->
    <ProjectReference Include="..\..\src\Benday.CommandsFramework.CmdUi\Benday.CommandsFramework.CmdUi.csproj" />
  </ItemGroup>
</Project>